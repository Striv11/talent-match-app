GEMINI_API_KEY=add_your_server_side_key
GEMINI_LIVE_MODEL=gemini-3.8-live
# Text model for JD writing, parsing, ranking and the command bar (falls back automatically when busy)
GEMINI_TEXT_MODEL=gemini-3.8-flash
GOOGLE_CLIENT_ID=add_your_google_oauth_client_id
SESSION_SECRET=replace_with_a_random_secret_at_least_32_characters
PORT=3000